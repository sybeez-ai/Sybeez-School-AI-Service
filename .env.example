APP_ENV=development
AI_HOST=0.0.0.0
AI_PORT=8001
AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+asyncpg://sybeez:sybeez@localhost:5432/sybeez_school
DATABASE_URL_SYNC=postgresql://sybeez:sybeez@localhost:5432/sybeez_school
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256

CORE_API_URL=http://localhost:8000
CORE_INTERNAL_TOKEN=dev-internal-service-token

LLM_PROVIDER=deepseek
CHAT_STREAM_ENABLED=true
EMBEDDING_DIM=1536

# --- Sarvam AI ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# --- Qwen ---
QWEN_VOICE_API_KEY=
QWEN_CHAT_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.alibaba.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_VOICE_MODEL=qwen-audio-turbo

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
