APP_ENV=development
AI_HOST=0.0.0.0
AI_PORT=8001
AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+asyncpg://sybeez:sybeez@localhost:5432/sybeez_school
DATABASE_URL_SYNC=postgresql://sybeez:sybeez@localhost:5432/sybeez_school
# RDS IAM auth. When true, the password in DATABASE_URL is ignored. The URL user
# (sybeez_app in production) gets a short-lived token, and TLS is required.
# DB_SSL_CA is an optional RDS CA bundle path used to verify the server certificate.
DB_IAM_AUTH=false
DB_SSL_CA=
REDIS_URL=redis://localhost:6379/0

# Cognito RS256 access/ID tokens, and School backend HS256 session tokens.
# Session tokens are signed with the same JWT_SECRET as the backend.
# create_access_token does not set iss or aud. Leave the next two empty until it does.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=

# Optional. When set, missing env vars are filled from this JSON secret.
# Explicit environment variables win. ECS can also inject secrets directly.
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_SECRET_ID=

LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
STREAM_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS=60
UPSTREAM_TIMEOUT_SECONDS=15
MAX_BODY_BYTES=1048576
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_PER_MINUTE=60
# Set true behind an ALB so the client IP is the last X-Forwarded-For hop.
TRUST_PROXY=false
WEB_CONCURRENCY=1

CORE_API_URL=http://localhost:8000
CORE_INTERNAL_TOKEN=dev-internal-service-token

LLM_PROVIDER=deepseek
CHAT_STREAM_ENABLED=true
EMBEDDING_DIM=1536

# --- Sarvam AI ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# --- Qwen ---
QWEN_VOICE_API_KEY=
QWEN_CHAT_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_VOICE_MODEL=qwen-audio-turbo

# Gemini Live speaks board narration when this key is set. auto uses it before Qwen.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
VOICE_PROVIDER=auto
TEACHER_SCHEMA_RETRIES=3
TEACHER_RATE_LIMIT_PER_MINUTE=20

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
